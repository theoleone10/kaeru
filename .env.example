# Copy to .env (never commit .env). Leave the Supabase values empty to run fully offline with no accounts.
# Supabase dashboard → Project Settings → API: Project URL and the publishable (anon) key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Shown as "Contact support" in Settings and in the privacy policy.
EXPO_PUBLIC_SUPPORT_EMAIL=
