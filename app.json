{
  "expo": {
    "name": "Kaeru",
    "slug": "kaeru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.theoleone.kaeru",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#48559C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.theoleone.kaeru",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#3D4FA8"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#48559C",
          "dark": {
            "backgroundColor": "#48559C"
          }
        }
      ],
      "expo-apple-authentication",
      "./plugins/app-intents/withAppIntents.js",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.547797680841-ulnhb3c7oqafesb9ugutftb34alu3vcq"
        }
      ]
    ],
    "scheme": "kaeru",
    "description": "Over 400 Japanese grammar points from JLPT N5 to N1, learned with spaced-repetition reviews.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "231dd7ae-77e6-4773-aed5-1a7cd5f7a387"
      }
    }
  }
}
